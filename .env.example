# ==============================================================================
# SIMU-COGNITION - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# Y en Vercel, agrega estas variables en:
#   Project Settings -> Environment Variables
# ==============================================================================

# 1. Base de datos (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# En Supabase -> Project Settings -> Database:
# Connection Pooling (Modo Transaction, puerto 6543) para Vercel Serverless:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión Directa (puerto 5432) usada por Prisma para migraciones / db push:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Autenticación (@sidebase/nuxt-auth / Auth.js)
# ------------------------------------------------------------------------------
# Clave secreta para firmar sesiones y tokens JWT. Puedes generar una con:
#   openssl rand -base64 32
AUTH_SECRET="tu-clave-secreta-super-segura-de-al-menos-32-caracteres"

# URL base de tu aplicación:
# En desarrollo local: http://localhost:3000
# En producción en Vercel: https://tu-proyecto.vercel.app
AUTH_ORIGIN="http://localhost:3000"

# 3. Microservicio Python de Machine Learning (Opcional si usas predicciones/curvas)
# ------------------------------------------------------------------------------
# URL del servicio Python (FastAPI):
# Local: http://127.0.0.1:8000
# Producción (Render / Railway / Vercel Serverless Python):
ML_SERVICE_URL="http://127.0.0.1:8000"
